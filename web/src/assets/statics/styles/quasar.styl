@import './quasar.variables'
@import '~quasar-styl'
// @import '~quasar-addon-styl'

.mg-active-btn
  width 100px
  background-color rgba(0, 145, 255, .11)
  color rgba(0, 145, 255, 1)
  border none
  .q-btn-inner .q-icon
    color #7BC0FC
  &:hover
    border 1px solid rgba(0, 145, 255, 1)
  &:active
    background-color rgba(0, 145, 255, 1)
    color #fff
    border none
    .q-btn-inner .q-icon
      color #fff
.mg-negative-btn
  width 100px
  background-color #bbc1c6
  color #fff
  border none
  &:hover
    border 1px solid #282828
  &:active
    background-color #282828
    border none
